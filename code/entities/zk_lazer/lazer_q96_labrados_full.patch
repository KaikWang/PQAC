+    if ((encoding >= 4U && py_wr_signed_int32vec(
+            &cur, &rem, pi->pi_pack->p[i]->p, 256)) ||
+        (encoding < 4U && py_wr(
+            &cur, &rem, pi->pi_pack->p[i]->p,
