+
+static int py_wr_lnp_field_blob(uint8_t **out, size_t *rem,
+                                const lnp_params pp, const lnp_proof pi) {
+  const size_t k = pp->kappa_linfmsis;
+  const size_t centered = 256 / N;
+  const size_t payload = py_lnp_field_blob_nbytes(pp);
