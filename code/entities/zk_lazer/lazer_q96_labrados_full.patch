+  if (py_rd_u64(in, rem, &got) || got != py_lnp_field_blob_nbytes(pp) ||
+      py_rd_polz_payload(in, rem, pi->m[0], 2 * k) ||
+      py_rd(in, rem, pi->m[2], centered * sizeof(polz)) ||
+      py_rd_polz_payload(in, rem, pi->m[3], 2 * k)) return 1;
+  return 0;
