+
+  memset(pp, 0, sizeof(*pp));
+  if (py_rd(&cur, &rem, magic, sizeof(magic)) ||
+      memcmp(magic, PY_PROOF_MAGIC, sizeof(PY_PROOF_MAGIC)) != 0) {
+    return 1;
